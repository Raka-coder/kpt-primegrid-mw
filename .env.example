# Master bind address (containers normally bind all interfaces)
PRIMEGRID_MASTER_HOST=0.0.0.0
PRIMEGRID_MASTER_PORT=50050
PRIMEGRID_MASTER_THREADS=64

# Address workers and clients use to reach the master
PRIMEGRID_MASTER_ADDRESS=localhost:50050
PRIMEGRID_JOB_TIMEOUT=3600.0
PRIMEGRID_WATCH_INTERVAL_MS=250

# Worker identity and bind/advertised address
PRIMEGRID_WORKER_ID=worker-1
PRIMEGRID_WORKER_HOST=0.0.0.0
PRIMEGRID_WORKER_PORT=50061
PRIMEGRID_WORKER_ADVERTISE_HOST=localhost
PRIMEGRID_WORKER_ADVERTISE_PORT=50061
PRIMEGRID_WORKER_CORES=1
PRIMEGRID_WORKER_THREADS=2

# Reliability
PRIMEGRID_HEARTBEAT_INTERVAL=2.0
PRIMEGRID_WORKER_DEAD_AFTER=6.0
PRIMEGRID_PROCESS_DEADLINE=60.0
PRIMEGRID_RPC_DEADLINE=3.0
PRIMEGRID_MAX_RETRIES=3
PRIMEGRID_PROCESS_MAX_RETRIES=2
PRIMEGRID_BACKOFF_BASE=0.5
PRIMEGRID_BACKOFF_MAX=10.0
PRIMEGRID_CHUNK_ATTEMPT_LIMIT=3
PRIMEGRID_DEDUP_TTL=3600.0
PRIMEGRID_DEFAULT_CHUNK_SIZE=100000
PRIMEGRID_MAX_RANGE=10000000
PRIMEGRID_MAX_CHUNKS=100000
PRIMEGRID_JOB_STALL_TIMEOUT=600.0
PRIMEGRID_HEALTH_INTERVAL=1.0
PRIMEGRID_SHUTDOWN_GRACE=5.0
PRIMEGRID_LOG_LEVEL=INFO

# Compose-only host port mappings
PRIMEGRID_WORKER_1_PORT=50061
PRIMEGRID_WORKER_2_PORT=50062
PRIMEGRID_WORKER_3_PORT=50063

# Fault injection (0 disables)
PRIMEGRID_FAULT_DELAY_PROBABILITY=0.0
PRIMEGRID_FAULT_DELAY_MAX_MS=0
PRIMEGRID_FAULT_ERROR_PROBABILITY=0.0
